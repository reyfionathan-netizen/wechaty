{
  "compilerOptions": {
    /**
     * ES Module support
     */
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",

    /**
     * Type import/export checkings
     * Note: importsNotUsedAsValues was removed in TypeScript 5.5+
     * Using verbatimModuleSyntax: false as replacement
     */
    "verbatimModuleSyntax": false,
    "isolatedModules": true,

    /**
     * Output settings
     */
    "outDir": "dist/esm",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    /**
     * Library and module resolution
     */
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    /**
     * Decorator support
     */
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    /**
     * Strict type checking
     */
    "strict": true,
    "noEmitOnError": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "noFallthroughCasesInSwitch": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noUnusedParameters": true,
    "noImplicitThis": true,
    "forceConsistentCasingInFileNames": true,

    /**
     * Other settings
     */
    "traceResolution": false,
    "noLib": false
  },
  "exclude": [
    "node_modules/",
    "dist/",
    "tests/fixtures/",
  ],
  "include": [
    "app/**/*.ts",
    "bin/*.ts",
    "bot/**/*.ts",
    "examples/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.spec.ts",
  ],
  "ts-node": {
    "transpileOnly": true,
    "transpiler": "ts-node/transpilers/swc-experimental"
  }
}
